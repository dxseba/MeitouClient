<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Brutality</AssemblyName>
    <RootNamespace>Meitou.Brutality</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <DefineConstants>$(DefineConstants);BRUTALITY_STOCK_MASTER</DefineConstants>

    <DefineConstants Condition="'$(StockSaveProbe)' == 'true'">$(DefineConstants);BRUTALITY_STOCK_SAVE_PROBE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Published clients use the release assembly version. Local engine builds default to 1.0.0.0. -->
    <ProjectReference Include="../../src/Meitou.Core/Meitou.Core.csproj;
                               ../../src/Meitou.Data/Meitou.Data.csproj;
                               ../../src/Meitou.Simulation/Meitou.Simulation.csproj;
                               ../../src/Meitou.Game/Meitou.Game.csproj"
                      Private="false" AdditionalProperties="AssemblyVersion=0.18.1.0" />
    <Compile Include="../Brutality/Gameplay/BrutalityStateCodec.cs;../Brutality/Bridge/LegacyGoreSave.cs" />
    <Compile Include="../Brutality/Effects/EffectContracts.cs;../Brutality/Effects/GoreEffectRenderer.cs;../Brutality/Effects/GoreEffectShaders.cs;../Brutality/Effects/LiquidBlood*.cs;../Brutality/Effects/RobotBreakExplosionGeometry.cs;../Brutality/Effects/RobotDischarge*.cs;../Brutality/Effects/RobotVisualRandom.cs" />
    <Compile Include="../Brutality/Gameplay/BrutalityProgress.cs;../Brutality/Gameplay/BrutalityPolicy.cs;../Brutality/Gameplay/CombatWoundMechanism.cs" />
    <Compile Include="../Brutality/Rendering/MeshCut.cs;../Brutality/Rendering/HeadBurstGeometry.cs;../Brutality/Physics/RagdollPhysics.cs;../Brutality/Physics/RagdollHull.cs;../Brutality/AnatomyAssets.cs;../Brutality/Anatomy/AnatomyFile.cs;../Brutality/Gameplay/HeadCut.cs" />
    <Compile Include="../Brutality/Gameplay/TorsoBisectionPolicy.cs;../Brutality/Gameplay/TorsoBisectionState.cs;../Brutality/Rendering/MechanicalAnatomy.cs" />
    <Compile Include="../Brutality/Physics/RagdollDefinition.cs;../Brutality/Physics/RagdollCut.cs;../Brutality/Physics/RagdollSkinSurface.cs;../Brutality/Physics/RobotRagdollWeight.cs;../Brutality/Physics/AdvancedFragmentScene.cs;../Brutality/Physics/AdvancedFragmentScene.Anchors.cs;../Brutality/Physics/AdvancedFragmentScene.Carry.cs" />
    <Compile Include="../Brutality/Anatomy/AnatomyLibrary.cs;../Brutality/Physics/BowelPose.cs;../Brutality/Physics/BowelRagdollScene.cs;../Brutality/Effects/BowelAssetPreparation.cs;../Brutality/Effects/BowelPresentation.cs;../Brutality/Effects/BowelSkinning.cs;../Brutality/Effects/BowelDiagnostics.cs;../Brutality/Effects/GutEmergence.cs;../Brutality/Effects/RobotCableSimulation.cs" />
    <Compile Include="../Brutality/Physics/AdvancedFragmentScene.Save.cs" />
    <Compile Include="../Brutality/Gameplay/WeaponBloodState*.cs;../Brutality/Bridge/CutEquipmentAdapter.Save.cs;../Brutality/Bridge/CutEquipmentAdapter.Containers.cs;../Brutality/Rendering/WeaponBloodGeometry.cs" />
    <Compile Include="../Brutality/Gameplay/BrutalityHeadPolicy.cs;../Brutality/Gameplay/SevereHeadWoundState.cs;../Brutality/Gameplay/HeadWoundPlacementPolicy.cs;../Brutality/Gameplay/BodyWoundState.cs;../Brutality/Gameplay/BodyWounds.cs;../Brutality/Gameplay/WoundPolicy.cs" />
    <Compile Include="../Brutality/Rendering/HeadReliefGeometry.cs;../Brutality/Rendering/BodyWoundGeometry.cs;../Brutality/Rendering/AnatomyGeometry.cs;../Brutality/Rendering/AnatomyFitCache.cs" />
    <Compile Include="../Brutality/Rendering/Surface/NativeSectionGeometry*.cs;../Brutality/Rendering/Surface/NativeSurfaceRecords.cs" />
    <Compile Include="../Brutality/Gameplay/ChestHole.cs;../Brutality/Rendering/Surface/ChestHoleFrame.cs;../Brutality/Rendering/Surface/ChestHoleGeometry.cs;../Brutality/Rendering/Surface/ChestHoleShader.cs" />
    <None Include="../Brutality/assets/anatomy/**/*" Link="assets/anatomy/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Brutality/Gameplay/LimbCutState.cs;../Brutality/Gameplay/LimbCutPolicy.cs;../Brutality/Gameplay/PairedLimbPolicy.cs;../Brutality/Physics/RagdollSeverance.cs" />
    <Compile Include="../Brutality/Effects/RobotScrapSimulation.cs" />
    <Compile Include="../Brutality/Physics/CutWeaponDrops.cs;../Brutality/Physics/RagdollSkinSurface.Equipment.cs" />
    <Compile Include="../Brutality/Ui/BrutalityUiExtension.cs;../Brutality/Ui/FragmentLimbLabels.cs" />
    <None Update="meitou.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE;../../LICENSE-EXCEPTION.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Brutality/assets/effects/**/*" Link="assets/effects/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
